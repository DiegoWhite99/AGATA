# Copia este archivo como .env y completa los valores (el .env no se sube a git).
# Sin clave, AGATA funciona igual: el match se calcula sin el componente de IA.

# Clave de Groq para el oráculo IA: https://console.groq.com/keys
GROQ_API_KEY=

# Opcional; por defecto openai/gpt-oss-120b
GROQ_MODEL=

# Opcional: tokens por minuto de tu plan de Groq (el gratuito permite 8000). Con un plan mayor,
# súbelo y el oráculo recortará menos la información que envía.
GROQ_TPM=

# Opcional: token de GitHub (solo lectura pública) para leer más perfiles por hora.
# Sin él, GitHub permite unas 60 consultas por hora (cada postulante usa entre 2 y 5).
GITHUB_TOKEN=

# --- Inicio de sesión (Firebase Authentication con cuentas Google) ---
# Configuración web de Firebase: Configuración del proyecto → Tus apps → la app web. No es secreta.
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
# Opcional; por defecto <FIREBASE_PROJECT_ID>.firebaseapp.com
FIREBASE_AUTH_DOMAIN=

# Correos que siempre son administradores, separados por comas (así entra el primero)
AGATA_ADMINS=

# Clave con la que AGATA firma la cookie de sesión. Genérala tú (no la compartas ni la subas a git) con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AGATA_SECRET_KEY=

# 1 = trabajar en tu computador sin inicio de sesión (entras como administrador). Solo vale con
# `python app.py`; en el servidor (PythonAnywhere) no tiene efecto.
AGATA_SIN_LOGIN=

# Solo para pruebas: 1 = un administrador también puede dar la aprobación final de la dirección (que si no es solo
# del cargo de dirección de la cadena de mando). En producción déjalo vacío.
AGATA_ADMIN_APRUEBA=
